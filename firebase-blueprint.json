{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["client", "admin", "stylist"] },
        "displayName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["email", "role", "displayName", "createdAt", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "A booking made by a client for a service with a stylist.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "maxLength": 128 },
        "stylistId": { "type": "string", "maxLength": 128 },
        "serviceName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "price": { "type": "number" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["clientId", "stylistId", "serviceName", "date", "status", "price", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Retail or backbar product.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "enum": ["retail", "backbar"] },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "sku": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["name", "category", "price", "stock", "sku", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Shop order by a client.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "maxLength": 128 },
        "items": { "type": "array", "maxLength": 20 },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "delivered"] },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["clientId", "items", "total", "status", "createdAt", "updatedAt"]
    },
    "GiftCard": {
      "title": "GiftCard",
      "description": "Digital gift voucher.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "balance": { "type": "number" },
        "themeId": { "type": "string", "maxLength": 50 },
        "recipientName": { "type": "string", "maxLength": 100 },
        "recipientEmail": { "type": "string", "maxLength": 100 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderEmail": { "type": "string", "maxLength": 100 },
        "senderId": { "type": "string", "maxLength": 128 },
        "giftNote": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["active", "redeemed", "expired"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["code", "amount", "balance", "recipientName", "recipientEmail", "senderName", "senderId", "status", "createdAt"]
    },
    "Hairstyle": {
      "title": "Hairstyle",
      "description": "AI Try-On Hairstyle Option.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "estimatedTime": { "type": "string", "maxLength": 50 },
        "servicePrice": { "type": "string", "maxLength": 50 },
        "iconSymbol": { "type": "string", "maxLength": 50 },
        "overlayStyle": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["name", "category", "estimatedTime", "servicePrice"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Client and Admin profiles."
    },
    "appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Salon bookings."
    },
    "products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Inventory products."
    },
    "orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Client shop orders."
    },
    "giftcards/{cardId}": {
      "schema": { "$ref": "#/entities/GiftCard" },
      "description": "Digital gift vouchers."
    },
    "hairstyles/{hairstyleId}": {
      "schema": { "$ref": "#/entities/Hairstyle" },
      "description": "AI Try-On Hairstyle catalog items."
    },
    "system/{docId}": {
      "schema": "any",
      "description": "System config and test documents."
    }
  }
}
