rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mubirushafik1088@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Consultation Chat & Private Formula Notes
    match /consultations/{appointmentId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Products (Inventory)
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Services (Dynamic Menu)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    // Transformations (Before & After Showcase)
    match /transformations/{transformationId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // System config & connection test
    match /system/{docId} {
      allow read, write: if true;
    }

    // Content management (Homepage, Lookbook)
    match /content/{docId} {
      allow read, write: if true;
    }

    // Gallery (Lookbook)
    match /gallery/{itemId} {
      allow read, write: if true;
    }

    // Waitlist
    match /waitlist/{waitlistId} {
      allow read, write: if true;
    }

    // Staff Roster & Shifts
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Reminders & Notifications Log
    match /reminders/{reminderId} {
      allow read, write: if true;
    }

    // Gift Cards & Digital Vouchers
    match /giftcards/{cardId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // AI Try-On Hairstyles Catalog
    match /hairstyles/{hairstyleId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
